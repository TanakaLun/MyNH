<?xml version="1.0" encoding="utf-8"?><!--
   Cloud backup / device transfer rules. The encrypted account key must never leave the device.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="file" path="account_secret.dat"/>
  </cloud-backup>
  <device-transfer>
    <exclude domain="file" path="account_secret.dat"/>
  </device-transfer>
</data-extraction-rules>
